<div class="container mt-4">
  <div class="row">
    <div class="col-md-8 offset-md-1">
      <h1>User info</h1>
      <table class="table">
        <tbody>
          <tr>
            <td rowspan="2" style="width: 120px;">
              <% if @user.profile_image.attached? %>
                <%= image_tag @user.profile_image, style: "width:100px; height:100px; object-fit:cover;" %>
              <% else %>
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="width:100px; height:100px;">NO IMAGE</div>
              <% end %>
            </td>
            <th>name</th>
            <td><%= @user.name %></td>
          </tr>
          <tr>
            <th>introduction</th>
            <td><%= @user.introduction %></td>
          </tr>
        </tbody>
      </table>

      <% if @user == Current.session.user %>
        <%= link_to edit_user_path(@user), class: "btn btn-outline-secondary btn-sm" do %>
          <i class="fa-solid fa-user-gear"></i>
        <% end %>
      <% end %>

      <h1 class="mt-4">Books</h1>
      <table class="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Opinion</th>
          </tr>
        </thead>
        <tbody>
          <% @user.books.each do |book| %>
            <tr>
              <td>
                <%= link_to user_path(book.user) do %>
                  <i class="fa-solid fa-user"></i>
                <% end %>
                <%= link_to book.title, book_path(book) %>
              </td>
              <td><%= book.body %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/sidebar", user: @user %>
  </div>
</div>


