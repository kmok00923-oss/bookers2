<div class="container mt-5" style="max-width: 400px;">
  <h1>Sign up</h1>

  <% if flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>

  <% if @user.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: users_path do |form| %>
    <div class="mb-3">
      <%= form.label :name %>
      <%= form.text_field :name, class: "form-control", required: true %>
    </div>
    <div class="mb-3">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, class: "form-control", required: true, autocomplete: "username" %>
    </div>
    <div class="mb-3">
      <%= form.label :password, "Password (6 characters minimum)" %>
      <%= form.password_field :password, class: "form-control", required: true, autocomplete: "new-password" %>
    </div>
    <div class="mb-3">
      <%= form.label :password_confirmation %>
      <%= form.password_field :password_confirmation, class: "form-control", required: true, autocomplete: "new-password" %>
    </div>
    <%= form.submit "Sign up", class: "btn btn-success" %>
  <% end %>

  <p class="mt-2"><%= link_to "Log in", new_session_path %></p>
</div>