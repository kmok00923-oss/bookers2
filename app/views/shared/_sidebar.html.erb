<div class="col-md-3">
  <div class="card mb-3 text-center">
    <div class="card-body">
      <% if user.profile_image.attached? %>
        <%= image_tag user.profile_image, class: "rounded-circle mb-2", style: "width:80px; height:80px; object-fit:cover;" %>
      <% else %>
        <%= image_tag "https://via.placeholder.com/80", class: "rounded-circle mb-2" %>
      <% end %>
      <%= link_to edit_user_path(user) do %>
        <i class="fa-solid fa-user-gear"></i>
      <% end %>
      <h5><%= user.name %></h5>
      <p><%= user.introduction %></p>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <h5>New book</h5>
      
      <%= form_with model: @new_book, url: books_path do |form| %>
        <div class="mb-2">
          <%= form.label :title %>
          <%= form.text_field :title, class: "form-control" %>
        </div>
        <div class="mb-2">
          <%= form.label :body, "Opinion" %>
          <%= form.text_area :body, class: "form-control" %>
        </div>
        <%= form.submit "Create Book", class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>
</div>